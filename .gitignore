# Variables de entorno (NO subir credenciales)
.env

# Archivos de subida de WordPress
wp-content/uploads/

# Directorio de actualización de WordPress
wp-content/upgrade/

# Caché
wp-content/cache/

# Backups
wp-content/backup-db/
wp-content/backups/

# Archivos de sistema
.DS_Store
Thumbs.db

# Logs
*.log
debug.log

# Volúmenes de Docker
docker-volumes/

# WordPress core (se descarga automáticamente — no versionar)
wp-admin/
wp-includes/
wp-*.php
xmlrpc.php
index.php
license.txt
readme.html

# WordPress config (contiene credenciales)
wp-config.php

# Base de datos SQLite (generada automáticamente)
wp-content/database/*.sqlite
wp-content/database/*.sqlite-shm
wp-content/database/*.sqlite-wal

# Plugins instalados desde el panel WP (no versionar binarios)
wp-content/plugins/akismet/
wp-content/plugins/sqlite-database-integration/

# Drop-in generado (se regenera desde el plugin SQLite)
wp-content/db.php

# Otros archivos de WordPress generados
wp-content/upgrade/
wp-content/languages/

# IDEs
.idea/
.vscode/
*.swp
*.swo
