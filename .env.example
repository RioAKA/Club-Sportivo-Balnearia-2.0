# =============================================================================
# Club Sportivo Balnearia — Variables de entorno
# Copiar este archivo como `.env` y completar los valores reales.
# NUNCA subir el archivo `.env` real al repositorio Git.
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=tu_password_root_aqui
MYSQL_DATABASE=sportivo_db
MYSQL_USER=sportivo_user
MYSQL_PASSWORD=tu_password_aqui

# --- WordPress (conexión a la base de datos) ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=sportivo_db
WORDPRESS_DB_USER=sportivo_user
WORDPRESS_DB_PASSWORD=tu_password_aqui
WORDPRESS_TABLE_PREFIX=csb_

# --- WordPress (modo desarrollo) ---
# Cambiar a 0 en producción
WORDPRESS_DEBUG=1
WORDPRESS_DEBUG_LOG=1
